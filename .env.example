# Application
SEEJOB_ENV=development
SEEJOB_DEBUG=true
SEEJOB_SECRET_KEY=change-me-to-a-random-32-byte-string

# Database (SQLite for dev; use PostgreSQL in production)
SEEJOB_DATABASE_URL=sqlite:///./seejob.db

# Credential encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEEJOB_FERNET_KEY=

# API server
SEEJOB_HOST=127.0.0.1
SEEJOB_PORT=8000
SEEJOB_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Document storage
SEEJOB_DOCUMENTS_DIR=./generated/documents

# Browser session persistence (ATS cookies)
SEEJOB_BROWSER_PROFILES_DIR=./seejob/data/browser_profiles

# Rate limits (defaults; overridden by PolicyConfig in DB)
SEEJOB_DEFAULT_DAILY_APPLY_LIMIT=10

# Vector store (Phase 1)
SEEJOB_CHROMA_PERSIST_DIR=./chroma_data
SEEJOB_VECTOR_ENABLED=false

# LLM / embeddings (OpenAI-compatible API)
SEEJOB_OPENAI_API_KEY=
SEEJOB_OPENAI_BASE_URL=https://api.openai.com/v1
SEEJOB_LLM_MODEL=gpt-4o-mini
SEEJOB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEEJOB_EMBEDDING_PROVIDER=hash

# Worker / scheduling (Phase 1+)
SEEJOB_SOURCING_CRON=0 8 * * *

# Gmail OTP (IMAP app password)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_USER=
GMAIL_APP_PASSWORD=

# CapSolver (optional — captcha auto-solve)
SEEJOB_CAPSOLVER_API_KEY=
